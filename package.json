{
  "name": "@wwl/weekend-web-labs",
  "version": "0.1.1",
  "private": true,
  "description": "Weekend Web Labs — demo playground for wwl-cbun widgets and Hex Earth",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nostromo-618/weekend-web-labs.git"
  },
  "keywords": [
    "wwl",
    "weekend-web-labs",
    "labs",
    "demo",
    "widgets",
    "hex-earth"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:qa": "vite build --mode qa",
    "preview": "vite preview",
    "demo:serve": "vite",
    "docs:check": "node utils/check-chat-doc-links.mjs",
    "lint": "eslint \"utils/**/*.{js,mjs}\" \"src/**/*.{js,mjs}\"",
    "format": "prettier --write \"utils/**/*.{js,mjs}\" \"src/**/*.{js,mjs,vue,css}\"",
    "format:check": "prettier --check \"utils/**/*.{js,mjs}\" \"src/**/*.{js,mjs,vue,css}\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:unit": "playwright test tests/unit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@vanduo-oss/vd3": "1.8.0",
    "@wwl/wwl-cbun": "link:../wwl-cbun",
    "@wwl/wwl-hex-earth": "link:../wwl-hex-earth",
    "vue": "3.5.44"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "overrides": {
      "adm-zip": "0.6.1",
      "sharp": "0.35.5",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "brace-expansion@>=5 <5.0.12": "5.0.12"
    }
  }
}
